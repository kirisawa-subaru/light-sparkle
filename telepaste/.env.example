# telepaste configuration. Copy to ~/.telepaste/.env (or ./.env) and edit.

# --- Telegram ---------------------------------------------------------------
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to use the bot. Leave empty on first run:
# the bot then answers every message with the sender's chat id.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional HTTP/SOCKS proxy for Telegram, e.g. http://127.0.0.1:7890
#TELEGRAM_PROXY=
# Optional alternative Bot API base URL (a self-hosted Bot API server or relay).
#TELEGRAM_API_BASE=

# --- Clipboard --------------------------------------------------------------
# auto | pbcopy (macOS) | wl-copy (Wayland) | xclip | xsel (X11, text only)
# | powershell (Windows) | off
CLIPBOARD=auto

# Put the clipboard on another machine instead: an ssh alias with key auth.
# Requires an explicit CLIPBOARD backend for that machine (pbcopy, wl-copy, xclip, xsel).
#CLIPBOARD_SSH_HOST=macbook

# Messages older than this many seconds are saved but not copied
# (queued messages from an outage should not overwrite your clipboard).
CLIPBOARD_MAX_AGE=120

# What a photo puts on the clipboard: image | url | markdown
# (url and markdown need the S3 settings below; default is url when S3 is set).
#CLIPBOARD_PHOTO=image

# --- Notes ------------------------------------------------------------------
# Folder for daily notes (YYYY-MM-DD.md + attachments/). Empty = no notes.
#JOURNAL_DIR=~/Notes/inbox
# Timezone for timestamps and file names (IANA name). Default: system local.
#JOURNAL_TZ=Asia/Shanghai

# --- Optional upload (S3, Cloudflare R2, Tencent COS, Aliyun OSS, MinIO) ----
# From light-sparkle/telepaste: uv tool install ".[s3]"
#S3_BUCKET=
#S3_ENDPOINT_URL=https://cos.ap-beijing.myqcloud.com
#S3_REGION=ap-beijing
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
# Public origin or CDN in front of the bucket. Unset = presigned links.
#S3_PUBLIC_BASE_URL=https://img.example.com
#S3_PREFIX=telepaste
#S3_URL_EXPIRE=604800

# Where /quiet is remembered. Default ~/.telepaste/state.json
#STATE_FILE=
